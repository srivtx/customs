# ─────────────────────────────────────────────────────────────────────────────
# Customs — environment. Test mode only. Live keys are refused at construction.
# Copy to .env (never commit .env). Without Razorpay keys the app runs on the
# labeled simulation rail — captures are stamped SIMULATED, never silent.
# ─────────────────────────────────────────────────────────────────────────────

# Razorpay TEST keys — dashboard > settings > API keys (test mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret (dashboard > settings > webhooks) — only needed in deployment
# where Razorpay can reach your public URL. Point the webhook at /api/hook/webhook.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Optional — LLM brain for intent parsing (default: deterministic rules brain,
# zero keys, replayable). Set ONE key; all of these are OpenAI-compatible.
# Groq and Gemini have real free tiers — the ablation's LLM arm can be filled
# without spending anything. When a key is set, also set AGENT_BRAIN=llm.
# OPENAI_API_KEY=sk-...
# GROQ_API_KEY=gsk_...            # free tier · api.groq.com
# GEMINI_API_KEY=AIza...          # free tier · generativelanguage.googleapis.com
# XAI_API_KEY=xai-...             # grok models · api.x.ai
# Generic OpenAI-compatible endpoint (self-hosted etc.):
# LLM_API_KEY=...
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_MODEL=your-model            # overrides the provider default
# AGENT_BRAIN=llm

# Optional — override state dir (defaults to ./data/state)
# CUSTOMS_STATE_DIR=./data/state
